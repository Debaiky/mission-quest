# Local development environment. Copy to .env.local to override; never commit real secrets.
DATABASE_URL="postgresql://postgres@localhost:5433/mission_quest"
DIRECT_URL="postgresql://postgres@localhost:5433/mission_quest"
SESSION_SECRET="replace-with-32-plus-random-bytes"
CRON_SECRET="replace-with-a-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_SEED="true"
# Optional providers (leave empty locally)
RESEND_API_KEY=""
EMAIL_FROM="Mission Quest <noreply@example.com>"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
